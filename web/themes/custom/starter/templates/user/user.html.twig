{#
  Page auteur — portrait, bio, réseaux, tribunes de l'auteur.
#}
<article{{ attributes.addClass('c-author', 'c-author--page') }}>
  <header class="c-author__header">
    {% if content.user_picture|render|trim %}
      <div class="c-author__avatar c-author__avatar--lg">{{ content.user_picture }}</div>
    {% endif %}
    <div class="c-author__identity">
      <h1 class="c-author__name">{{ user.getDisplayName() }}</h1>
      {% if content.field_bio|render|trim %}
        <div class="c-author__bio">{{ content.field_bio }}</div>
      {% endif %}
      <ul class="c-author__social">
        {% if content.field_twitter|render|trim %}
          <li class="c-author__social-item c-author__social-item--twitter">{{ content.field_twitter }}</li>
        {% endif %}
        {% if content.field_linkedin|render|trim %}
          <li class="c-author__social-item c-author__social-item--linkedin">{{ content.field_linkedin }}</li>
        {% endif %}
      </ul>
    </div>
  </header>

  <section class="c-author__tribunes" aria-label="Tribunes de l'auteur">
    <h2 class="c-author__tribunes-title">Ses tribunes</h2>
    {% set author_view = drupal_view_result('tribunes_par_auteur', 'page', user.id) %}
    {% if author_view is not empty %}
      {{ drupal_view('tribunes_par_auteur', 'page', user.id) }}
    {% else %}
      {{ content|without('user_picture', 'field_bio', 'field_twitter', 'field_linkedin') }}
    {% endif %}
  </section>
</article>
