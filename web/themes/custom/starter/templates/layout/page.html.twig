{#
  Page wrapper générique — Le Guide Santé.
#}
{{ attach_library('starter/global') }}
<a class="u-sr-only u-sr-only--focusable" href="#main">Aller au contenu</a>

<header class="c-header" role="banner">
  <div class="u-container c-header__inner">
    <div class="c-header__brand">
      {{ page.header }}
    </div>

    <button type="button"
            id="c-nav-toggle"
            class="c-nav__toggle"
            aria-expanded="false"
            aria-controls="c-primary-nav"
            aria-label="Ouvrir le menu">
      <span class="c-nav__toggle-bar" aria-hidden="true"></span>
      <span class="c-nav__toggle-bar" aria-hidden="true"></span>
      <span class="c-nav__toggle-bar" aria-hidden="true"></span>
    </button>

    {% if page.primary_menu %}
      <nav id="c-primary-nav" class="c-nav" aria-label="Navigation principale">
        {{ page.primary_menu }}
      </nav>
    {% endif %}
  </div>
</header>

{% if page.breadcrumb %}
  <div class="c-breadcrumb">
    <div class="u-container">{{ page.breadcrumb }}</div>
  </div>
{% endif %}

{% if page.highlighted %}
  <div class="c-highlighted u-container">{{ page.highlighted }}</div>
{% endif %}

{% if page.hero %}
  <section class="c-hero" aria-label="En-tête éditorial">
    {{ page.hero }}
  </section>
{% endif %}

<main id="main" class="c-main" role="main" tabindex="-1">
  <div class="u-container c-main__inner">
    <div class="c-main__content">
      {{ page.content }}
    </div>
    {% if page.sidebar_first %}
      <aside class="c-sidebar c-sidebar--first" aria-label="Contenu complémentaire">
        {{ page.sidebar_first }}
      </aside>
    {% endif %}
    {% if page.sidebar_second %}
      <aside class="c-sidebar c-sidebar--second" aria-label="Informations additionnelles">
        {{ page.sidebar_second }}
      </aside>
    {% endif %}
  </div>
</main>

<footer class="c-footer" role="contentinfo">
  {% if page.footer_top %}
    <div class="c-footer__top">
      <div class="u-container">{{ page.footer_top }}</div>
    </div>
  {% endif %}
  {% if page.footer_bottom %}
    <div class="c-footer__bottom">
      <div class="u-container">{{ page.footer_bottom }}</div>
    </div>
  {% endif %}
</footer>
